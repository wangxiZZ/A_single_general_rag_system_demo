# =============================================================================
# 只保留本项目实际会产生、且不应入库的文件。
# 规则：密钥与运行期数据必须忽略；锁文件（uv.lock）、Skill 安装副本、夹具要提交。
# =============================================================================

# Python 字节码与扩展
__pycache__/
*.py[cod]
*$py.class
*.so

# 构建/打包产物
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境与工具缓存
.venv/
venv/
env/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# 密钥与本地配置：只提交 .env.example
.env
.env.*
!.env.example
*.pem
*.key
*.p12
.pypirc

# Claude Code 本机设置（可能含个人权限/路径）；.claude/skills 要提交，不能忽略整个目录
.claude/settings.local.json

# 运行期数据：上传件、抽出的图片、日志
# 用 data/* 而非 data/：直接忽略目录时，目录内的例外规则（!.gitkeep）不生效
data/*
!data/.gitkeep
logs/
*.log

# 编辑器与操作系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 本地工具目录
.workbuddy/
