# =============================================================================
# 通用 RAG 知识库服务 — 环境变量模板
#
# 用法：
#   cp .env.example .env      然后填写「模型能力」段落的 API Key
#   make up
#
# 说明：
#   1. .env 已被 .gitignore 忽略，密钥不会进仓库。
#   2. 「存储凭据」段落同时被 docker compose（拼装服务密码/端口）和本机直跑使用。
#   3. 每个变量都能在 src/rag_kb/config.py 的 Settings 里找到同名字段。
# =============================================================================

# ---------------------------- 应用 ----------------------------
APP_ENV=dev
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# 宿主机侧的数据目录（上传文件、抽取图片）。容器内固定挂载为 /data。
DATA_DIR=./data
MAX_UPLOAD_MB=50

# ------------------------- PostgreSQL -------------------------
# 业务元数据 + 词法索引（jieba 分词后由 PG 做 to_tsvector/GIN）
PG_USER=rag
PG_PASSWORD=rag_local_pw
PG_DB=ragkb
PG_PORT=5432
# 若本机已有 PostgreSQL 服务占用 5432，改成 5433 并同步 PG_DSN，避免 localhost 连到别的实例
# 本机直跑（不经 compose）时取消下一行注释，把 host 改成 localhost：
# PG_DSN=postgresql://rag:rag_local_pw@localhost:5432/ragkb

# --------------------------- Milvus ---------------------------
MILVUS_PORT=19530
MILVUS_HTTP_PORT=9091
# 宿主机直跑时改为 http://localhost:19530
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=chunk_vec
# 必须与 EMBED_MODEL 的输出维度一致（qwen3.7-text-embedding-flash 实测 1024），否则启动 fail-fast
EMBEDDING_DIM=1024

# ---------------------------- Neo4j ---------------------------
NEO4J_USER=neo4j
# Neo4j 要求密码至少 8 位
NEO4J_PASSWORD=ragkb_neo4j_pw
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# 宿主机直跑时改为 bolt://localhost:7687
NEO4J_URI=bolt://neo4j:7687

# ======================= 模型能力（必填）=======================
# 三者都走 OpenAI 兼容协议，因此可以分别指向不同厂商。
# 不填也能启动（/readyz 会标记为「未配置」），但解析索引与回答功能不可用。

# --- 生成与图谱抽取：DeepSeek ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
# 网关 /models 实际列出 deepseek-flash；deepseek-chat 是别名
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_S=90
LLM_MAX_CONCURRENCY=4

# --- 向量化：qwen3.7-text-embedding-flash（Qwen MaaS，OpenAI 兼容）---
# 实测输出 1024 维，必须与 EMBEDDING_DIM 一致
EMBED_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
EMBED_API_KEY=
EMBED_MODEL=qwen3.7-text-embedding-flash
EMBED_BATCH_SIZE=16
EMBED_TIMEOUT_S=60

# --- 图片描述：qwen3-vl-plus（同一 Qwen MaaS，统一鉴权）---
# 关闭 VLM 时图片仍会入索引，但描述退化为占位符，便于断网调试。
VLM_ENABLED=true
VLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
VLM_API_KEY=
VLM_MODEL=qwen3-vl-plus
VLM_TIMEOUT_S=90

# ======================= 分块与检索调参 =======================
# 子块目标长度（token）。调大可提升上下文完整度，调小可提升检索精度。
CHUNK_TARGET_TOKENS=320
# 子块重叠比例，按句子边界切分，不会截断句子
CHUNK_OVERLAP_RATIO=0.15
# 父块（回填上下文用）上限。命中子块后回填父块给 LLM
PARENT_MAX_TOKENS=1200
# 中文 token 估算系数：1 token ≈ 1.5 汉字，仅用于分块长度控制
CHARS_PER_TOKEN=1.5

# 单通道召回条数
RETRIEVAL_TOP_K=20
# RRF 融合参数，k 越大越平滑
FUSION_RRF_K=60
# 重排默认关闭：RRF 已解决异构分数不可比，重排收益需用 benchmark 验证（见 docs/benchmark.md）
RERANK_ENABLED=false
# 重排端点先占位；只有 RERANK_ENABLED=true 时才要求填写
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_API_KEY=
RERANK_TIMEOUT_S=60
# 图谱召回最大跳数与种子实体上限
GRAPH_MAX_HOPS=2
GRAPH_SEED_LIMIT=8
